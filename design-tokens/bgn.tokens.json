{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "BGN Web Design System application subset",
    "source": "https://ds.biznetgio.com/skills.md",
    "sourceVersion": "1.3.25"
  },
  "tokens": {
    "color-primary-900": "#06583A",
    "color-primary-800": "#0B714D",
    "color-primary-700": "#118D62",
    "color-primary-600": "#29AE87",
    "color-primary-500": "#46E1B4",
    "color-primary-400": "#78FFCF",
    "color-primary-300": "#B5FFE5",
    "color-primary-200": "#D4F6E9",
    "color-primary-100": "#E6F5EE",
    "color-neutral-900": "#101211",
    "color-neutral-800": "#2F3E43",
    "color-neutral-700": "#55636B",
    "color-neutral-600": "#7F8B96",
    "color-neutral-500": "#939EAB",
    "color-neutral-400": "#B9C4CE",
    "color-neutral-300": "#DCE3EA",
    "color-neutral-200": "#ECF1F6",
    "color-neutral-100": "#F9FBFD",
    "color-neutral-0": "#FFFFFF",
    "color-text-primary": "{color-neutral-900}",
    "color-text-body": "{color-neutral-700}",
    "color-text-secondary": "{color-neutral-600}",
    "color-text-muted": "{color-neutral-500}",
    "color-background-page": "{color-neutral-100}",
    "color-background-surface": "{color-neutral-0}",
    "color-background-subtle": "{color-neutral-200}",
    "color-background-brand-soft": "{color-primary-100}",
    "color-border-default": "{color-neutral-300}",
    "color-border-divider": "{color-neutral-100}",
    "color-status-connected": "{color-primary-700}",
    "color-status-connected-bg": "{color-primary-100}",
    "color-status-disconnected": "#C61A0B",
    "color-status-disconnected-bg": "#FEECEC",
    "color-warning": "#FDB72A",
    "color-warning-bg": "#FFF9E7",
    "color-warning-text": "#8A5A00",
    "font-ui": "Geist, Inter, system-ui, sans-serif",
    "font-mono": "JetBrains Mono, Consolas, monospace",
    "font-size-hero": "40px",
    "font-size-page-title": "24px",
    "font-size-section-title": "20px",
    "font-size-body": "16px",
    "font-size-small": "14px",
    "font-size-table": "13px",
    "font-size-caption": "12px",
    "font-line-height-ui": "1.4",
    "font-line-height-body": "1.6",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",
    "space-16": "64px",
    "space-20": "80px",
    "radius-xs": "4px",
    "radius-sm": "8px",
    "radius-md": "12px",
    "radius-lg": "16px",
    "radius-xl": "24px",
    "radius-card": "12px",
    "radius-pill": "999px",
    "shadow-sm": "0 8px 24px rgba(16, 18, 17, 0.04)",
    "shadow-md": "0 8px 24px rgba(16, 18, 17, 0.08)",
    "transition-fast": "120ms ease",
    "transition-base": "150ms ease",
    "focus-ring-color": "rgba(17, 141, 98, 0.24)",
    "focus-ring-width": "3px",
    "layout-container-max": "1280px",
    "layout-page-gap": "32px",
    "layout-section-gap": "24px",
    "layout-inline-gap": "12px",
    "component-surface-border-color": "{color-border-default}",
    "component-table-border-color": "{color-border-default}",
    "component-tab-selected-color": "{color-primary-700}",
    "component-tab-default-color": "{color-neutral-700}",
    "component-tab-pressed-layer": "{color-primary-100}"
  }
}
