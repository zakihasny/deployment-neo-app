{
  "name": "test-deployment-neo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node scripts/build-tokens.mjs",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "nuxt typecheck",
    "check": "pnpm tokens:check && pnpm typecheck && node scripts/check.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node --experimental-strip-types --test test/integration/*.test.ts"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "mysql2": "3.24.6",
    "mariadb": "3.5.5",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@rollup/wasm-node": "4.63.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
}
